# Ignore everything by default
*

# Re-open directories so specific files below can be unignored
!*/

# Keep repository metadata and companion-document files
!.gitignore
!README.md
!LICENSE
!banded_dotterel_moult.qmd
!banded_dotterel_moult.html

# Keep the figure assets that are directly referenced by the README/qmd
!figs/fig2.png
!figs/combined_figure_draft.png

# Keep the input data objects required by the Quarto document
!data/moult_breeding_KK_data.rds
!data/breeding_KK_data.rds
!data/nests_KK_data.rds

# Keep the saved model objects that let the qmd reproduce manuscript results
# without refitting the time-consuming Bayesian models
!out/sex_mod_.rds
!out/sex_age_class_mod_2.rds
!out/sex_age_avg_mod_.rds
!out/sex_migratory_status_mod_.rds
!out/sex_first_breed_only_mod_.rds
!out/sex_last_nest_first_obs_only_mod_.rds
!out/sex_last_breed_only_mod_.rds
!out/mod_age_class_first_brms_.rds
!out/mod_age_class_lay_brms_.rds
!out/mod_age_class_last_brms_.rds
!out/mod_age_first_brms_.rds
!out/mod_age_lay_brms_.rds
!out/mod_age_last_brms_.rds
!out/sex_sibling_all_mod_.rds
!out/sex_sibling_fy_mod_.rds
!out/sex_sibling_afy_mod_.rds

# Local IDE files
.Rproj.user
